{
  "name": "windows-notch",
  "productName": "Windows Notch",
  "version": "0.3.1",
  "description": "A MacBook-style notch for Windows: now playing, volume & brightness HUD, quick toggles, File Shelf, clipboard history, weather and more.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win dir --x64 --publish never"
  },
  "keywords": [
    "windows",
    "notch",
    "dynamic-island",
    "electron",
    "desktop",
    "customization"
  ],
  "author": "Nithin0029",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.nithin0029.windows-notch",
    "productName": "Windows Notch",
    "copyright": "Copyright © 2026 Nithin0029",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-settings.js",
      "updater.js",
      "weather.js",
      "weather-icons.js",
      "notch.html",
      "notch.js",
      "settings.html",
      "settings.js",
      "helper.ps1",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "helper.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nithin0029",
        "repo": "Windows-Notch"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows Notch",
      "runAfterFinish": true,
      "artifactName": "Windows-Notch-Setup-${version}.exe"
    }
  }
}
